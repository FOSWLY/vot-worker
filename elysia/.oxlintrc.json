{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error",
        "perf": "error",
        "suspicious": "warn"
    },
    "rules": {
        "no-async-endpoint-handlers": "off"
    },
    "ignorePatterns": [
        "**/*.d.ts",
        "ecosystem.config.js"
    ],
    "plugins": ["promise", "import", "eslint", "oxc", "typescript", "unicorn"]
}